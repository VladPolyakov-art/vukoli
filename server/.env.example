# Copy to app/server/.env for development. Real environment variables win over this file.
# Never put API keys here: keys are entered in the app and stored in settings.json in the data folder.

# Where sessions, settings and models live (default: the OS app-data folder, via platformdirs).
# IC_DATA_DIR=./.devdata

# Kokoro speech model folder (kokoro-v1.0.onnx + voices-v1.0.bin). Default: <data dir>/models/kokoro.
# Point it at an existing download to avoid copying 300+ MB, for example:
# KOKORO_MODEL_DIR=/path/to/kokoro-models

# Ollama address (default http://127.0.0.1:11434)
# OLLAMA_URL=http://127.0.0.1:11434

# Server address (default 127.0.0.1:8000, this computer only)
# IC_HOST=127.0.0.1
# IC_PORT=8000

# Extra origins allowed to call the API and the session socket (the Vite dev server)
# IC_DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
