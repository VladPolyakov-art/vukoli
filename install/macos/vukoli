#!/bin/bash
# Vukoli launcher (macOS). Installed as <prefix>/bin/vukoli.
#   vukoli            start the app if it is not running, then open it in its own window
#                     (Chrome / Edge / Chromium / Brave app mode: no tabs, no address bar), or in the app
#                     Chrome / Edge installed for Vukoli ("Install" offer in the app: own Dock icon)
#   vukoli --browser  same, but open a normal tab in the default browser (or set VUKOLI_APP_WINDOW=0)
#   vukoli stop       stop the app
#   vukoli status     say whether the app is running
#   vukoli logs       print the log file path
#   vukoli autostart off|status   stop (or check) "start Ollama with the computer" if the installer set it up
# Port: IC_PORT (default 8000). The app listens on this computer only (127.0.0.1).
# VUKOLI_NO_BROWSER=1 opens nothing. VUKOLI_APP_WINDOW=0 opens the default browser instead of an app window.
set -u

# Resolve this script's real location (follows symlinks) -> <prefix>/bin/vukoli.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
PREFIX="$(cd -P "$(dirname "$src")/.." && pwd)"

PORT="${IC_PORT:-8000}"
HOST=127.0.0.1
URL="http://$HOST:$PORT"
PY="$PREFIX/venv/bin/python"
LOGDIR="$PREFIX/logs"
LOG="$LOGDIR/server.log"
PIDFILE="$PREFIX/server.pid"
USE_TAB=0

say() { printf '%s\n' "$*"; }
notify() {   # started from the app icon (VUKOLI_GUI=1) there is no terminal: show a dialog as well
  say "$*"
  if [ "${VUKOLI_GUI:-}" = 1 ] && command -v osascript >/dev/null 2>&1; then
    osascript -e "display dialog \"${*//\"/\\\"}\" with title \"Vukoli\" buttons {\"OK\"} default button 1 giving up after 120" >/dev/null 2>&1 || true
  fi
}

is_vukoli() {   # health answers with Vukoli's own JSON
  local body
  body="$(curl -fsS --max-time 2 "$URL/api/health" 2>/dev/null)" || return 1
  case "$body" in *'"data_version"'*) return 0 ;; *) return 1 ;; esac
}

port_busy() {
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1
  else
    (exec 3<>"/dev/tcp/$HOST/$PORT") 2>/dev/null
  fi
}

server_pid() {   # pid from the pid file if it is really our server, else whoever listens on the port
  local pid=""
  if [ -f "$PIDFILE" ]; then
    pid="$(cat "$PIDFILE" 2>/dev/null)"
    if [ -n "$pid" ] && ps -p "$pid" -o command= 2>/dev/null | grep -q -- "-m server"; then
      echo "$pid"; return 0
    fi
  fi
  if command -v lsof >/dev/null 2>&1; then
    pid="$(lsof -nP -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -n 1)"
    if [ -n "$pid" ] && ps -p "$pid" -o command= 2>/dev/null | grep -q -- "-m server"; then
      echo "$pid"; return 0
    fi
  fi
  return 1
}

# Print the path of the first Chromium-based browser found (Chrome, Edge, Chromium, Brave), or nothing.
find_chromium() {
  local entry name id d app
  for entry in "Google Chrome|com.google.Chrome" "Microsoft Edge|com.microsoft.edgemac" "Chromium|org.chromium.Chromium" "Brave Browser|com.brave.Browser"; do
    name="${entry%%|*}"; id="${entry##*|}"
    for d in /Applications "$HOME/Applications"; do
      if [ -d "$d/$name.app" ]; then echo "$d/$name.app"; return 0; fi
    done
    if command -v mdfind >/dev/null 2>&1; then   # installed somewhere else
      app="$(mdfind "kMDItemCFBundleIdentifier == '$id'" 2>/dev/null | head -n 1)"
      if [ -n "$app" ] && [ -d "$app" ]; then echo "$app"; return 0; fi
    fi
  done
  return 1
}

# The app that Chrome / Edge / Chromium / Brave installed for Vukoli ("Install as an app": its own Dock icon). It is found
# by the address it opens, not by its name or folder. Prints its path, or nothing.
find_installed_app() {
  local dir app url
  for dir in "$HOME/Applications" /Applications; do
    for app in "$dir"/*Apps.localized/*.app; do
      [ -d "$app" ] || continue
      url="$(defaults read "$app/Contents/Info" CrAppModeShortcutURL 2>/dev/null)" || continue
      case "${url%/}" in "$URL"|"http://localhost:$PORT") echo "$app"; return 0 ;; esac
    done
  done
  return 1
}

open_default_browser() {
  if command -v open >/dev/null 2>&1; then open "$URL"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$URL" >/dev/null 2>&1 || true
  fi
}

# Own window in the user's normal profile, so the microphone permission is remembered. First choice is the installed app
# (open -a brings its window forward, or opens one: a second window is never added). Otherwise Chromium app mode;
# open -n starts a new process that hands the window to the running browser, if there is one.
open_browser() {
  if [ "${VUKOLI_NO_BROWSER:-}" = 1 ]; then return 0; fi
  if [ "${VUKOLI_APP_WINDOW:-1}" != 0 ] && [ "$USE_TAB" != 1 ] && command -v open >/dev/null 2>&1; then
    local app
    if app="$(find_installed_app)" && open -a "$app" >/dev/null 2>&1; then
      return 0
    fi
    if app="$(find_chromium)" && open -na "$app" --args "--app=$URL" --window-size=1280,860 >/dev/null 2>&1; then
      return 0
    fi
    say "Vukoli works best in Chrome or Edge, which open it as its own window. Opening your default browser instead."
  fi
  open_default_browser
}

cmd_start() {
  if is_vukoli; then
    say "Vukoli is already running: $URL"
    open_browser; return 0
  fi
  if port_busy; then
    notify "Port $PORT is used by another program, not by Vukoli. Close that program, or start Vukoli on another port: IC_PORT=8001 $PREFIX/bin/vukoli"
    return 1
  fi
  if [ ! -x "$PY" ] || [ ! -d "$PREFIX/app/server/server" ]; then
    notify "Vukoli is not installed completely ($PREFIX). Run the install command again to repair it."
    return 1
  fi
  mkdir -p "$LOGDIR"
  say "Starting Vukoli..."
  ( cd "$PREFIX/app/server" && { nohup "$PY" -m server --port "$PORT" >>"$LOG" 2>&1 </dev/null & echo $! >"$PIDFILE"; disown; } )
  local i=0
  while [ $i -lt 60 ]; do   # up to 30 s
    if is_vukoli; then
      say "Vukoli is running: $URL"
      open_browser; return 0
    fi
    sleep 0.5; i=$((i + 1))
  done
  notify "Vukoli did not start within 30 seconds. See the log: $LOG"
  return 1
}

cmd_stop() {
  local pid
  if ! pid="$(server_pid)"; then
    if is_vukoli; then
      say "Vukoli answers on port $PORT, but it was not started from this install. Stop it yourself."
      return 1
    fi
    say "Vukoli is not running."
    rm -f "$PIDFILE"; return 0
  fi
  kill "$pid" 2>/dev/null || true
  local i=0
  while [ $i -lt 20 ] && kill -0 "$pid" 2>/dev/null; do sleep 0.25; i=$((i + 1)); done
  if kill -0 "$pid" 2>/dev/null; then kill -9 "$pid" 2>/dev/null || true; fi
  rm -f "$PIDFILE"
  say "Vukoli stopped."
}

cmd_autostart() {
  local plist="$HOME/Library/LaunchAgents/com.vukoli.ollama.plist"
  case "${1:-status}" in
    off)
      if [ -f "$plist" ]; then
        launchctl bootout "gui/$(id -u)/com.vukoli.ollama" >/dev/null 2>&1 || true
        rm -f "$plist"
        say "Ollama will no longer start with your computer. Ollama itself stays installed."
      else
        say "The installer did not set up start-at-login for Ollama. If Ollama still starts with your computer, turn it off in System Settings > General > Login Items."
      fi ;;
    status) if [ -f "$plist" ]; then say "Ollama starts with your computer (set up by the Vukoli installer)."; else say "No start-at-login entry from the Vukoli installer."; fi ;;
    *) say "Use: autostart off | autostart status"; return 2 ;;
  esac
}

if [ "${1:-}" = "--browser" ]; then USE_TAB=1; shift; fi

case "${1:-start}" in
  start|open|"") cmd_start ;;
  stop) cmd_stop ;;
  status) if is_vukoli; then say "Vukoli is running: $URL"; else say "Vukoli is not running."; exit 1; fi ;;
  logs) say "$LOG" ;;
  autostart) shift; cmd_autostart "${1:-status}" ;;
  -h|--help|help) sed -n 2,11p "$src" | sed 's/^# \{0,1\}//' ;;
  *) say "Unknown command: $1 (use: start, stop, status, logs)"; exit 2 ;;
esac
